
# Convex Configuration

# Deployment name generated by `npx convex dev`
CONVEX_DEPLOYMENT="your-convex-deployment"

# Public Convex endpoint
NEXT_PUBLIC_CONVEX_URL="https://your-project.convex.cloud"

# Public site URL (used for sharing links, metadata, etc.)
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-app.vercel.app"



# Clerk Authentication

# Public key (safe to expose to the client)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Secret key (server-side only)
CLERK_SECRET_KEY="sk_test_..."

# Clerk JWT issuer domain
CLERK_JWT_ISSUER_DOMAIN="https://your-project.clerk.accounts.dev"



# Cloudinary

# Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Unsigned upload preset
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"